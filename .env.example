# No real secrets belong in this file or client code.
# Hosted: configure these through Sites runtime secrets.
# Local: use an ignored .dev.vars / environment supplied to Wrangler.
COMMUNICATION_MODE=test
# Required only for the authenticated external scheduler endpoint.
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
# Enable only for recipients within an active WhatsApp customer-service window.
WHATSAPP_SESSION_MESSAGES=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
